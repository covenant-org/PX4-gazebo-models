<?xml version="1.0" encoding="UTF-8"?>
<sdf version='1.9'>
	<model name='x500_depth_servo'>
		<include merge='true'>
			<uri>x500</uri>
		</include>
		<include merge='true'>
			<uri>model://OakD-Lite</uri>
			<pose>.12 .03 .242 0 0 0</pose>
		</include>
		<joint name="CameraJoint" type="fixed">
			<parent>base_link</parent>
			<child>OakD-Lite/base_link</child>
			<pose relative_to="base_link">.12 .03 .242 0 0 0</pose>
		</joint>

		<joint name="auxiliary_motor_joint" type="revolute">
			<parent>base_link</parent>
			<child>auxiliary_motor</child>
			<axis>
				<xyz>0 0 1</xyz>
			</axis>
		</joint>

		<link name="auxiliary_motor">
			<pose>0.1 0 -0.05 0 0 0</pose>
			<inertial>
				<mass>0.1</mass>
				<inertia>
					<ixx>0.001</ixx>
					<iyy>0.001</iyy>
					<izz>0.001</izz>
				</inertia>
			</inertial>
			<visual name="auxiliary_motor_visual">
				<geometry>
					<cylinder>
						<radius>0.02</radius>
						<length>0.05</length>
					</cylinder>
				</geometry>
			</visual>
		</link>
	</model>
</sdf>